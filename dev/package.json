{
  "name": "payload-table-field-dev",
  "description": "Payload 3 Next.js harness for the payload-table-field package",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build:plugin": "pnpm --dir .. build",
    "predev": "pnpm build:plugin && pnpm generate:importmap",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "prebuild": "pnpm build:plugin && pnpm generate:importmap",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "pregenerate:importmap": "pnpm build:plugin",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "pregenerate:types": "pnpm build:plugin",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "pretest:smoke": "pnpm build:plugin",
    "test:smoke": "cross-env NODE_OPTIONS=--no-deprecation tsx --test plugin.spec.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "next": "16.2.6",
    "payload": "^3.84.1",
    "payload-table-field": "link:..",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
