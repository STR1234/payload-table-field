{
  "name": "payload-table-field-dev",
  "description": "Payload 3 Next.js harness for the payload-table-field package",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:plugin": "npm --prefix .. run build",
    "predev": "npm run build:plugin && npm run generate:importmap",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "prebuild": "npm run build:plugin && npm run generate:importmap",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "pregenerate:importmap": "npm run build:plugin",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "pregenerate:types": "npm run build:plugin",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "pretest:smoke": "npm run build:plugin",
    "test:smoke": "cross-env NODE_OPTIONS=--no-deprecation tsx --test plugin.spec.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "next": "16.2.6",
    "payload": "^3.0.0",
    "payload-table-field": "file:..",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.6.3"
  }
}
