{
  "name": "payload-table-field",
  "version": "1.1.0",
  "description": "A table field for Payload CMS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./types": {
      "import": "./dist/exports/types.js",
      "types": "./dist/exports/types.d.ts",
      "default": "./dist/exports/types.js"
    }
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "payload": "^3.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.28",
    "@types/jest": "^29.5.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "5.12.1",
    "@typescript-eslint/parser": "5.12.1",
    "copyfiles": "^2.4.1",
    "dotenv": "^8.2.0",
    "eslint": "^8.19.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.7.0",
    "payload": "^3.0.0",
    "prettier": "^2.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-node": "9.1.1",
    "typescript": "^5.6.3",
    "webpack": "^5.90.3"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && npm run copy",
    "copy": "copyfiles -u 1 \"src/**/*.css\" \"src/**/*.json\" dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "payload",
    "react-table",
    "payload-plugin",
    "field"
  ],
  "author": "notchris <mail@chrismcgrane.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/notchris/payload-table-field/issues"
  },
  "homepage": "https://github.com/notchris/payload-table-field#readme",
  "dependencies": {
    "@payloadcms/ui": "^3.0.0",
    "@tanstack/match-sorter-utils": "^8.15.1",
    "@tanstack/react-table": "^8.16.0",
    "react-animate-height": "^3.2.3"
  }
}
